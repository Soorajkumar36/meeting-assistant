# --------------------
# Audio Capture
# --------------------
AUDIO_DURATION_SECONDS=${AUDIO_DURATION_SECONDS:-60}
AUDIO_SAMPLE_RATE=${AUDIO_SAMPLE_RATE:-16000}
AUDIO_CHANNELS=${AUDIO_CHANNELS:-1}
AUDIO_STORAGE_PATH=${AUDIO_STORAGE_PATH:-data/raw_audio}

# --------------------
# ASR / Diarization
# --------------------
# --------------------
# Pyannote Cloud
# --------------------
PYANNOTE_API_KEY=${PYANNOTE_API_KEY}

# --------------------
# LLM
# --------------------
# Ollama Cloud
# --------------------
OLLAMA_API_KEY=${OLLAMA_API_KEY}
LLM_PROVIDER=${LLM_PROVIDER:-ollama}
LLM_MODEL=${LLM_MODEL:-gpt-oss:120b-cloud}

# --------------------
# Security & Privacy
# --------------------
ENABLE_REDACTION=${ENABLE_REDACTION:-true}
DATA_RETENTION_DAYS=${DATA_RETENTION_DAYS:-7}

